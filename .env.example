# Copy this file to `.env` and fill in real values.

# ── AI features (Live Automation Builder #1, Business Audit #2, Blueprint wizard #4) ──
# Server-side only — never exposed to the browser. Without it, the AI features
# run in "demo" mode (a realistic mock response, no API call).
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Which model the AI features use. Defaults to claude-haiku-4-5 (fast + cheap,
# ideal for a live per-visitor demo). Set to claude-opus-4-8 for top quality.
ANTHROPIC_MODEL=claude-haiku-4-5

# Production server port (server/index.js). Defaults to 8080.
PORT=8080

# ── Contact form (Formspree) ──
# https://formspree.io — without it the contact form runs in demo mode.
VITE_FORMSPREE_ENDPOINT=
